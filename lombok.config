# Copy @Qualifier from a field onto the generated @RequiredArgsConstructor parameter, so
# constructor-injected beans keep their qualifier. Without this, Lombok drops @Qualifier and Spring
# would inject the @Primary bean instead — critically, jockey docs/evidence (which must stay on local
# disk) would bind to the public Cloudinary bean when app.storage.provider=cloudinary. See StorageWiringTest.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
